---
import PageLayout from "./PageLayout.astro";
import { SITE } from "../../config.mjs";
import { proseCSS } from "../helpers/apps";
const { frontmatter } = Astro.props;
const { title } = frontmatter;
const meta = {
  title: `${title} — ${SITE.name}`,
  description: frontmatter.description,
};
---

<PageLayout {meta}>
  <section class="mx-auto mb-20 max-w-3xl py-6 sm:py-10 md:min-h-screen">
    <main class={proseCSS}>
      <div class="">
        <slot />
      </div>
    </main>
  </section>
</PageLayout>
