---
import PageLayout from "../../layouts/PageLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getBlogPosts, slugifyTag } from "../../helpers/tags";

const posts = await getBlogPosts();

const meta = {
  title: "Blog - Julian Beck",
  description: "Technical blog posts about iOS development, Kubernetes, DevOps, and more.",
};
---

<PageLayout meta={meta} searchable={false}>
  <section class="mb-10 mt-6">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight text-white">Blog</h1>
      <a
        href="/blog/tags"
        class="shrink-0 text-sm text-neutral-500 transition-colors hover:text-white"
        >Browse tags →</a
      >
    </div>
    <p class="mt-3 max-w-xl leading-relaxed text-neutral-400">
      Technical articles about iOS development, Kubernetes, DevOps, and more.
    </p>
  </section>

  <div class="space-y-3">
    {
      posts.map((post) => (
        <article class="group relative rounded-2xl border border-white/[0.06] bg-[#121214] p-5 transition-colors hover:border-white/[0.12] hover:bg-[#151517]">
          <div class="mb-2 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
            <h2 class="font-medium text-white">
              <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0">
                {post.data.title}
              </a>
            </h2>
            <span class="shrink-0 text-sm tabular-nums text-neutral-600">
              <FormattedDate date={post.data.pubDate} />
            </span>
          </div>
          <p class="text-sm leading-relaxed text-neutral-500">
            {post.data.description}
          </p>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {post.data.tags.map((tag: string) => (
                <a
                  href={`/blog/tags/${slugifyTag(tag)}`}
                  class="relative z-10 rounded-full border border-white/[0.06] bg-white/[0.03] px-2.5 py-0.5 text-xs text-neutral-400 transition-colors hover:border-white/[0.12] hover:text-white"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</PageLayout>
