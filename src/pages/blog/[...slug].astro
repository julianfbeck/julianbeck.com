---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();

const isRelease = post.data.type === "release";

// Use custom ogImage, or generated OG image as fallback
const ogImage = post.data.ogImage || post.data.heroImage || `/og/${post.slug}.png`;

const meta = {
  title: `${post.data.title} - Julian Beck`,
  description: post.data.description,
  image: ogImage,
};
---

<PageLayout meta={meta}>
  <article class="max-w-none">
    <header class="mb-8">
      <a
        href="/blog"
        class="text-sky-400 hover:text-sky-300 text-sm mb-4 inline-block"
      >
        ← Back to Blog
      </a>

      {isRelease && post.data.release ? (
        <!-- Release Post Header -->
        <div class="bg-gradient-to-r from-slate-800 to-slate-900 border border-slate-700 rounded-xl p-6 mb-6">
          <div class="flex items-center gap-2 mb-4">
            <span class="bg-sky-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
              New Release
            </span>
            <span class="text-gray-500 text-sm">
              <FormattedDate date={post.data.pubDate} />
            </span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <img
              src={post.data.release.appIcon}
              alt={post.data.release.appName}
              class="w-24 h-24 rounded-2xl shadow-lg"
            />
            <div class="flex-1">
              <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">
                {post.data.release.appName}
              </h1>
              {post.data.release.tagline && (
                <p class="text-gray-400 text-lg mb-4">{post.data.release.tagline}</p>
              )}
              <div class="flex flex-wrap gap-3">
                <a
                  href={post.data.release.appStoreUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-white text-black font-semibold px-4 py-2 rounded-lg hover:bg-gray-100 transition-colors"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                  </svg>
                  App Store
                </a>
                {post.data.release.websiteUrl && (
                  <a
                    href={post.data.release.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-slate-700 text-white font-semibold px-4 py-2 rounded-lg hover:bg-slate-600 transition-colors"
                  >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="2" y1="12" x2="22" y2="12"/>
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    Website
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ) : (
        <!-- Regular Post Header -->
        <Fragment>
          {post.data.heroImage && (
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="w-full h-64 object-cover rounded-lg mb-6"
            />
          )}
          <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">
            {post.data.title}
          </h1>
          <div class="flex flex-wrap items-center gap-4 text-gray-400 text-sm mb-4">
            {post.data.author && <span>By {post.data.author}</span>}
            <span>
              <FormattedDate date={post.data.pubDate} />
            </span>
            {post.data.updatedDate && (
              <span class="italic">
                (Updated: <FormattedDate date={post.data.updatedDate} />)
              </span>
            )}
          </div>
        </Fragment>
      )}

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {post.data.tags.map((tag: string) => (
            <span class="px-2 py-1 text-xs rounded-md bg-slate-700 text-gray-300">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-invert prose-slate max-w-none
      prose-headings:text-white prose-headings:font-bold
      prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4
      prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3
      prose-p:text-gray-300 prose-p:leading-relaxed
      prose-a:text-sky-400 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-white
      prose-code:text-sky-300 prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-slate-800 prose-pre:border prose-pre:border-slate-700
      prose-img:rounded-lg prose-img:mx-auto
      prose-ul:text-gray-300 prose-ol:text-gray-300
      prose-li:marker:text-gray-500
      prose-blockquote:border-sky-500 prose-blockquote:text-gray-400
    ">
      <Content />
    </div>

    {isRelease && post.data.release && (
      <!-- Bottom CTA for release posts -->
      <div class="mt-12 p-6 bg-slate-800/50 border border-slate-700 rounded-xl text-center">
        <p class="text-gray-400 mb-4">Ready to try {post.data.release.appName}?</p>
        <a
          href={post.data.release.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-sky-500 text-white font-semibold px-6 py-3 rounded-lg hover:bg-sky-400 transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          Download on the App Store
        </a>
      </div>
    )}
  </article>
</PageLayout>
