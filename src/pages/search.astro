---
import PageLayout from "../layouts/PageLayout.astro";

const meta = {
  title: "Search - Julian Beck",
  description: "Search across apps, blog posts, and pages.",
};
---

<PageLayout meta={meta} searchable={false}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </Fragment>

  <section class="mb-8 mt-6" data-pagefind-ignore="all">
    <h1 class="text-3xl font-semibold tracking-tight text-white">Search</h1>
    <p class="mt-3 max-w-xl leading-relaxed text-neutral-400">
      Search across apps, blog posts, and pages.
    </p>
  </section>

  <div data-pagefind-ignore="all">
    <div id="pagefind-status" class="mb-4 text-sm text-neutral-500"></div>
    <div id="pagefind-search" class="pagefind-ui"></div>
  </div>

  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener("load", () => {
      const statusEl = document.getElementById("pagefind-status");
      const init = async () => {
        try {
          const res = await fetch("/pagefind/pagefind.js", { method: "HEAD" });
          if (!res.ok) {
            if (statusEl) {
              statusEl.textContent =
                "Search index not available in dev. Run the production build to generate it.";
            }
            return;
          }
        } catch (error) {
          if (statusEl) {
            statusEl.textContent =
              "Search index not available in dev. Run the production build to generate it.";
          }
          return;
        }

        if (window.PagefindUI) {
          new window.PagefindUI({
            element: "#pagefind-search",
            showSubResults: true,
            showImages: false,
            resetStyles: false,
          });
          if (statusEl) statusEl.textContent = "";
          document.querySelector(".pagefind-ui__search-input")?.focus();
        }
      };

      init();
    });
  </script>

  <style is:global>
    .pagefind-ui {
      --pagefind-ui-font: "DM Sans Variable", sans-serif;
    }

    .pagefind-ui__form::before {
      background-color: #737373;
    }

    .pagefind-ui__search-input {
      width: 100%;
      padding: 0.75rem 0.9rem;
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      background: #121214;
      color: #e5e5e5;
      font-weight: 400;
    }

    .pagefind-ui__search-input::placeholder {
      color: #737373;
      opacity: 1;
    }

    .pagefind-ui__search-input:focus {
      outline: 1px solid rgba(251, 146, 60, 0.5);
      outline-offset: 0;
    }

    .pagefind-ui__search-clear {
      color: #a3a3a3;
      background: transparent;
      font-size: 0.875rem;
    }

    .pagefind-ui__message {
      color: #737373;
      font-size: 0.875rem;
      font-weight: 400;
    }

    .pagefind-ui__result {
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 1rem;
      padding: 1.1rem 1.25rem;
      background: #121214;
      margin-top: 0.75rem;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .pagefind-ui__result:hover {
      border-color: rgba(255, 255, 255, 0.12);
      background: #151517;
    }

    .pagefind-ui__result-title {
      color: #ffffff;
      font-weight: 500;
    }

    .pagefind-ui__result-link {
      color: #ffffff;
    }

    .pagefind-ui__result-link:hover {
      text-decoration: underline;
      text-decoration-color: #525252;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-excerpt {
      color: #a3a3a3;
      font-size: 0.875rem;
      font-weight: 400;
    }

    .pagefind-ui__result-excerpt mark {
      background: rgba(251, 146, 60, 0.2);
      color: #fdba74;
      border-radius: 0.25rem;
      padding: 0 0.2rem;
    }

    .pagefind-ui__result-tags {
      gap: 0.4rem;
    }

    .pagefind-ui__result-tag {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      color: #a3a3a3;
      border-radius: 9999px;
      padding: 0.15rem 0.6rem;
      font-size: 0.7rem;
    }

    .pagefind-ui__button {
      background: #121214;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 9999px;
      color: #e5e5e5;
      font-weight: 400;
    }

    .pagefind-ui__button:hover {
      border-color: rgba(255, 255, 255, 0.12);
      background: #151517;
    }
  </style>
</PageLayout>
