---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PageLayout from "../layouts/PageLayout.astro";
import { fetchApps } from "../helpers/apps";

const apps = await fetchApps();

const meta = {
  title: `${SITE_TITLE} - Apps`,
  description: SITE_DESCRIPTION,
  image: "/images/og.png",
  url: "https://astro.build",
};
---

<PageLayout meta={meta} searchable={false}>
  <section class="mb-10 mt-6">
    <h1 class="text-3xl font-semibold tracking-tight text-white">
      My Projects and Apps
    </h1>
    <p class="mt-3 max-w-xl leading-relaxed text-neutral-400">
      Apps and side projects I've built — mostly iOS, sometimes web.
    </p>
  </section>

  <section class="grid gap-3 sm:grid-cols-2">
    {
      apps.map((app) => (
        <a
          href={app.slug}
          class="group flex flex-col rounded-2xl border border-white/[0.06] bg-[#121214] p-5 transition-colors hover:border-white/[0.12] hover:bg-[#151517]"
        >
          <div class="flex items-center gap-3">
            <img
              src={app.icon}
              alt={app.data.title || app.appDetails?.title || "App icon"}
              class="h-12 w-12 rounded-xl"
              loading="lazy"
            />
            <div class="font-medium text-white">
              {app.data.title || app.appDetails?.title || "Untitled"}
            </div>
          </div>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-500">
            {app.description}
          </p>
          {app.data.tags && app.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {app.data.tags.map((tag: string) => (
                <span class="rounded-full border border-white/[0.06] bg-white/[0.03] px-2.5 py-0.5 text-xs text-neutral-400">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      ))
    }
  </section>
</PageLayout>
