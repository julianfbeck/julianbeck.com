---
import { SITE } from "../../../config.mjs";
import { fetchApps, type DetailedApp, proseCSS } from "../../helpers/apps";
import Layout from "../../layouts/PageLayout.astro";
import ImageSlider from "../../components/ImageSlider";

export async function getStaticPaths() {
  const apps = await fetchApps();

  return apps.map((app) => ({
    params: {
      slug: app.slug,
    },
    props: {
      app,
    },
  }));
}

interface Props {
  app: DetailedApp;
}

const { app } = Astro.props;
const meta = {
  title: `${app.data.title} — ${SITE.name}`,
  description: app.data.description,
  image: app.icon,
  ogTitle: app.data.title,
  ogType: "product",
  appStoreId: app.data.appStoreId || "",
};
---

<Layout {meta}>
  <section class="mx-auto mb-10 max-w-3xl py-8 sm:py-12">
    <article>
      <header class="mb-16 flex flex-col items-center text-center">
        <img
          src={app.icon}
          width="160"
          height="160"
          alt={app.data.title}
          class="mb-6 h-40 w-40 rounded-[36px] border border-white/[0.06]"
        />
        <h1
          class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          {app.data.title}
        </h1>
        <h2 class="mt-3 max-w-xl text-lg leading-relaxed text-neutral-400">
          {app.data.description}
        </h2>
        <>
          {
            app.data.isIOSApp && app.data.appStoreId && (
              <div class="relative mt-8">
                <a href={app.appstoreUrl}>
                  <img
                    src="/base/download-on-app-store-badge.svg"
                    alt="Download on the App Store"
                    style="margin: 0; padding: 0; display: block; height: 56px; user-select: none"
                  />
                </a>
              </div>
            )
          }
        </>
        {
          Object.keys(app.data.links || {}).length > 0 && (
            <nav class="instapaper_ignore mt-8 flex max-w-md flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
              <>
                {Object.entries(app.data.links || {}).map(([title, url]) => (
                  <a
                    href={url}
                    class="text-neutral-400 transition-colors hover:text-white"
                  >
                    {title}
                  </a>
                ))}
              </>
            </nav>
          )
        }
      </header>
    </article>
    {
      app.screenshots.length > 0 && (
        <ImageSlider images={app.screenshots} client:load />
      )
    }
    <div class={proseCSS}>
      <app.Content />
    </div>
  </section>
</Layout>
