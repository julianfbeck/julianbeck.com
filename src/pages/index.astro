---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PageLayout from "../layouts/PageLayout.astro";
import { getPortfolioData } from "../helpers/portfolioData";

const { apps, positions, certifications, education, talks } =
  await getPortfolioData();
const eyevo = apps.find((a) => a.slug === "eyevo-tcg-scanner");

const formatTalkDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const meta = {
  title: SITE_TITLE,
  description: SITE_DESCRIPTION,
};
---

<PageLayout meta={meta}>
  <!-- Hero -->
  <section class="mb-10 mt-6">
    <h1 class="text-3xl font-semibold tracking-tight text-white">
      Julian Beck
    </h1>
    <p class="mt-3 max-w-xl leading-relaxed text-neutral-400">
      Cloud Platform Engineer at <a
        href="https://inovex.de/"
        class="text-white underline decoration-neutral-700 underline-offset-4 transition-colors hover:decoration-neutral-400"
        >inovex</a
      >. Interested in all stuff DevOps, Cloud, Golang as well as
      iOS-Development.
    </p>
  </section>

  <!-- New release -->
  <section
    class="mb-14 rounded-2xl border border-white/[0.06] bg-[#121214] p-4"
  >
    <div class="flex items-center gap-3.5">
      <img
        src={eyevo?.icon || "/eyevo/1.png"}
        alt="Eyevo icon"
        class="h-11 w-11 rounded-xl object-cover"
        loading="lazy"
      />
      <div class="min-w-0">
        <div
          class="text-xs font-medium uppercase tracking-wide text-neutral-500"
        >
          New release
        </div>
        <div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1">
          <a
            href="/eyevo-tcg-scanner"
            class="font-medium text-white hover:underline"
            >Eyevo – Pokémon TCG Scanner</a
          >
          <span class="text-neutral-700">·</span>
          <a
            href="https://eyevotcg.com/?utm_source=julianbeck.com&utm_medium=referral&utm_campaign=homepage-promo"
            target="_blank"
            rel="noopener"
            class="text-sm text-neutral-400 transition-colors hover:text-white"
            >eyevotcg.com</a
          >
          <span class="text-neutral-700">·</span>
          <a
            href="https://apps.apple.com/app/id6748607064?pt=120183609&ct=julianbeck-homepage&mt=8"
            target="_blank"
            rel="noopener"
            class="text-sm text-neutral-400 transition-colors hover:text-white"
            >App Store</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="mb-14">
    <h2 class="mb-5 text-lg font-semibold text-white">Personal Projects</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        apps.map((app) => (
          <a
            href={app.slug}
            class="group rounded-2xl border border-white/[0.06] bg-[#121214] p-5 transition-colors hover:border-white/[0.12] hover:bg-[#151517]"
          >
            <div class="flex items-center gap-3">
              <img
                src={app.icon}
                alt={app.data.title}
                class="h-10 w-10 rounded-xl"
                loading="lazy"
              />
              <div class="font-medium text-white">{app.data.title}</div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-neutral-500">
              {app.data.description}
            </p>
          </a>
        ))
      }
    </div>
    <a
      href="/apps"
      class="mt-6 inline-block text-sm text-neutral-500 transition-colors hover:text-white"
      >See all my apps →</a
    >
  </section>

  <!-- Experience -->
  <section class="mb-14">
    <h2 class="mb-5 text-lg font-semibold text-white">Work Experience</h2>
    <div
      class="divide-y divide-white/[0.06] rounded-2xl border border-white/[0.06] bg-[#121214]"
    >
      {
        positions.map((p) => (
          <a
            href={p.data.url}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between gap-4 px-5 py-4 transition-colors first:rounded-t-2xl last:rounded-b-2xl hover:bg-[#151517]"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <img
                src={p.data.logo}
                alt={`${p.data.company} logo`}
                class="h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-0.5"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class="font-medium text-white">{p.data.position}</div>
                <div class="mt-0.5 truncate text-sm text-neutral-500">
                  {p.data.company} · {p.data.description}
                </div>
              </div>
            </div>
            <span class="shrink-0 text-sm tabular-nums text-neutral-600">
              {p.data.from} – {p.data.to}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Meetups & Talks -->
  <section class="mb-14">
    <h2 class="mb-5 text-lg font-semibold text-white">Meetups & Talks</h2>
    <div
      class="divide-y divide-white/[0.06] rounded-2xl border border-white/[0.06] bg-[#121214]"
    >
      {
        talks.map((t) => (
          <a
            href={t.data.url}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between gap-4 px-5 py-4 transition-colors first:rounded-t-2xl last:rounded-b-2xl hover:bg-[#151517]"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <img
                src={t.data.logo}
                alt={`${t.data.event} logo`}
                class="h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-0.5"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class="font-medium text-white">{t.data.title}</div>
                <div class="mt-0.5 truncate text-sm text-neutral-500">
                  {t.data.type} · {t.data.event} · {t.data.location}
                </div>
              </div>
            </div>
            <span class="shrink-0 text-sm tabular-nums text-neutral-600">
              {formatTalkDate(t.data.date)}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Certifications -->
  <section class="mb-14">
    <h2 class="mb-5 text-lg font-semibold text-white">Certifications</h2>
    <div
      class="divide-y divide-white/[0.06] rounded-2xl border border-white/[0.06] bg-[#121214]"
    >
      {
        certifications.map((c) => (
          <a
            href={c.data.url}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between gap-4 px-5 py-4 transition-colors first:rounded-t-2xl last:rounded-b-2xl hover:bg-[#151517]"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <img
                src={c.data.logo}
                alt={`${c.data.company} logo`}
                class="h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-0.5"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class="font-medium text-white">{c.data.position}</div>
                <div class="mt-0.5 truncate text-sm text-neutral-500">
                  {c.data.company}
                </div>
              </div>
            </div>
            <span class="shrink-0 text-sm tabular-nums text-neutral-600">
              {c.data.from} – {c.data.to}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Education -->
  <section class="mb-14">
    <h2 class="mb-5 text-lg font-semibold text-white">Education</h2>
    <div
      class="divide-y divide-white/[0.06] rounded-2xl border border-white/[0.06] bg-[#121214]"
    >
      {
        education.map((e) => (
          <a
            href={e.data.url}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-between gap-4 px-5 py-4 transition-colors first:rounded-t-2xl last:rounded-b-2xl hover:bg-[#151517]"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <img
                src={e.data.logo}
                alt={`${e.data.company} logo`}
                class="h-9 w-9 shrink-0 rounded-lg bg-white object-contain p-0.5"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class="font-medium text-white">{e.data.position}</div>
                <div class="mt-0.5 truncate text-sm text-neutral-500">
                  {e.data.company} · {e.data.description}
                </div>
              </div>
            </div>
            <span class="shrink-0 text-sm tabular-nums text-neutral-600">
              {e.data.from} – {e.data.to}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Contact -->
  <section
    class="rounded-2xl border border-white/[0.06] bg-[#121214] p-6 text-center"
  >
    <h2 class="text-lg font-semibold text-white">Contact</h2>
    <p class="mt-2 text-neutral-400">
      If you are interested in contacting me, drop me a short email.
    </p>
    <a
      href="mailto:mail@julianbeck.com"
      class="mt-4 inline-block rounded-full bg-white px-5 py-2 text-sm font-medium text-black transition-colors hover:bg-neutral-200"
      >mail@julianbeck.com</a
    >
  </section>
</PageLayout>
