---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../../consts";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const redeemPages = await getCollection("redeem");
  return redeemPages.map((page) => ({
    params: { code: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await page.render();

const meta = {
  title: `${SITE_TITLE} - Redeem ${page.data.appName}`,
  description: `Get your promo code for ${page.data.appName}`,
};
---

<PageLayout meta={meta} searchable={false}>
  <div class="mx-auto my-10 max-w-2xl">
    <div class="rounded-2xl border border-white/[0.06] bg-[#121214] p-8">
      <div class="mb-6 text-center">
        <h1 class="mb-2 text-2xl font-semibold tracking-tight text-white">
          {page.data.appName}
        </h1>
        <a
          href={page.data.appLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-neutral-400 underline decoration-neutral-700 underline-offset-4 transition-colors hover:text-white hover:decoration-neutral-400"
        >
          Download {page.data.appName}
        </a>
      </div>

      <div class="prose prose-invert mb-6 max-w-none prose-p:text-neutral-400">
        <Content />
      </div>

      <div
        class="mb-6 rounded-xl border border-white/[0.06] bg-white/[0.03] p-6"
      >
        <h2 class="mb-4 text-lg font-semibold text-white">
          How to Redeem Your Code
        </h2>
        <div class="space-y-2 text-neutral-400">
          <p class="font-medium text-white">iOS:</p>
          <ol class="ml-4 list-inside list-decimal space-y-1 text-sm">
            <li>Open the App Store</li>
            <li>Tap your profile icon (top right)</li>
            <li>Go to "Redeem Gift Card or Code"</li>
            <li>Enter the promo code and tap "Redeem"</li>
            <li>Pick "Restore Purchase" on the paywall if you still see it!</li>
            <li>Relaunch the app</li>
          </ol>
        </div>
      </div>

      <div class="text-center">
        <button
          id="redeemButton"
          class="rounded-full bg-white px-6 py-2.5 text-sm font-medium text-black transition-colors hover:bg-neutral-200 disabled:opacity-60"
        >
          Get Promo Code
        </button>
      </div>

      <div id="redeemResult" class="mt-6 hidden rounded-xl p-4"></div>
    </div>
  </div>
</PageLayout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const redeemButton = document.getElementById('redeemButton') as HTMLButtonElement;
    const resultDiv = document.getElementById('redeemResult') as HTMLDivElement;
    
    redeemButton.addEventListener('click', async function() {
      redeemButton.disabled = true;
      redeemButton.textContent = 'Getting code...';
      
      try {
        const response = await fetch('https://redeem-worker.beanvault.workers.dev/api/redeem', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            codeSlug: window.location.pathname.split('/').pop()
          })
        });
        
        const data = await response.json();
        
        if (response.ok) {
          resultDiv.className = 'mt-6 p-4 rounded-xl bg-emerald-950/60 border border-emerald-800/50 text-emerald-200';
          resultDiv.innerHTML = `
            <h3 class="font-bold mb-2">Your Promo Code:</h3>
            <code class="text-lg font-mono bg-emerald-900/60 px-2 py-1 rounded">${data.code}</code>
            <p class="mt-2 text-sm">This code has been removed from our system and can only be used once.</p>
          `;
          redeemButton.style.display = 'none';
        } else {
          resultDiv.className = 'mt-6 p-4 rounded-xl bg-red-950/60 border border-red-900/50 text-red-200';
          resultDiv.textContent = data.error || 'Failed to get promo code. Please try again later.';
          redeemButton.disabled = false;
          redeemButton.textContent = 'Get Promo Code';
        }
        
        resultDiv.classList.remove('hidden');
        
      } catch (error) {
        resultDiv.className = 'mt-6 p-4 rounded-xl bg-red-950/60 border border-red-900/50 text-red-200';
        resultDiv.textContent = 'Network error. Please try again later.';
        resultDiv.classList.remove('hidden');
        redeemButton.disabled = false;
        redeemButton.textContent = 'Get Promo Code';
      }
    });
  });
</script>