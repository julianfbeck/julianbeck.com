---
const { href, class: className, ...props } = Astro.props;
const { pathname } = Astro.url;

const currentPath = pathname.slice(1).replace(/\.\w+$/, ""); // Remove the first `/` and file extension.
const isActive = currentPath.startsWith(href.replace(/^\//, ""));

const activeClass = "md:bg-white/[0.06] text-white";
const linkClass = `${
  isActive ? activeClass : "text-neutral-400"
} flex items-center rounded-full px-4 py-3 transition-colors hover:text-white md:px-3 md:py-1.5 md:hover:bg-white/[0.06]`;
---

<li>
  <a href={href} class:list={[className, ...linkClass.split(" ")]} {...props}>
    <slot />
  </a>
</li>
